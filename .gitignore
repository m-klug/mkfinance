# OS
.DS_Store

# Java / Maven
target/

# Node
node_modules/
dist/
coverage/

# Secrets and machine-local env.
# Note: .env.example and .env.development are intentionally NOT ignored —
# they hold safe, shareable dev config (e.g. VITE_API_MOCK=true).
.env
.env.local
.env.*.local

# Postgres dumps written by the docker `backup` service — never commit data.
docker/backups/

# Docker image bundles built for offline deploy (`docker save ... | gzip`).
# Large, regenerable artifacts — never commit them.
docker/*.tar.gz
/*.tar.gz

# curl cookie jars left over from manual API testing — they hold live
# session/CSRF tokens. Never commit.
*.cookie-jar
docker/jar.txt

# Real bank statements used as parser fixtures — personal data, never commit.
docs/samples/

# Knowledge-graph output generated by graphify: regenerable, never commit.
graphify-out/
