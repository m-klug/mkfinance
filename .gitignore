# OS
.DS_Store

# Java / Maven
target/

# Node
node_modules/
dist/
coverage/

# Secrets and machine-local env.
# Note: .env.example and .env.development are intentionally NOT ignored —
# they hold safe, shareable dev config (e.g. VITE_API_MOCK=true).
.env
.env.local
.env.*.local

# Postgres dumps written by the docker `backup` service — never commit data.
mk-finance/docker/backups/

# Docker image bundles built for offline deploy (`docker save ... | gzip`).
# Large, regenerable artifacts — never commit them.
mk-finance/docker/*.tar.gz

# curl cookie jars left over from manual API testing — they hold live
# session/CSRF tokens. Never commit.
*.cookie-jar
mk-finance/docker/jar.txt

# Claude Code machine-local settings (agents/ and launch.json ARE tracked)
.claude/settings.local.json

# Lock de sessão do Claude Code — guarda pid e sessionId da máquina local.
# Foi versionado por engano no 4ef57ce; nunca deve voltar.
**/.claude/scheduled_tasks.lock

# worktrees temporários dos agentes
.claude/worktrees/
